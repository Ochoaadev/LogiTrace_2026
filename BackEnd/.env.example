# Backend Environment Variables
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/LogiTrace?schema=public"

# JWT
# En producción: propio y de 32+ caracteres (genere uno con: npm run secreto)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"

# Server
PORT=3000
NODE_ENV=development

# Detrás de un proxy inverso con HTTPS (Caddy/Nginx): 1 = confiar en el primer proxy para la IP del cliente
# TRUST_PROXY=1

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://192.168.0.123:5173

# Seed en producción: claves iniciales de las cuentas (si faltan, se generan al azar y se muestran una vez)
# SEED_CLAVE_ADMIN=
# SEED_CLAVE_SUPERVISOR=
# SEED_CLAVE_OPERADOR=
# SEED_CLAVE_REPARTIDOR=

# Respaldos (npm run respaldo): carpeta de destino, cuántos conservar y ruta de pg_dump si no está en el PATH
# RESPALDO_DIR=./respaldos
# RESPALDO_CONSERVAR=14
# Frase secreta para CIFRAR los respaldos (AES-256-GCM); guárdela fuera del servidor, sin ella no se restauran
# RESPALDO_CLAVE=
# PG_DUMP="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
